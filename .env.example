# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube a git (ver .gitignore).

# --- Supabase (base de datos + auth) ---
SUPABASE_URL=
SUPABASE_KEY=
# Recomendado para backend (bypassa RLS en operaciones server-side).
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexion DIRECTA a Postgres (Project Settings > Database >
# Connection string). Usa el Session pooler o la conexion directa
# (puerto 5432) - NO el Transaction pooler (puerto 6543), que rompe el
# checkpointer del agente de chat (PostgresSaver de LangGraph).
DATABASE_URL=

# --- OpenAI (motor del bot de citas) ---
OPENAI_API_KEY=
# Opcional: modelo de chat a usar. Default: gpt-4.1-mini
CHAT_MODEL_NAME=

# --- WhatsApp Cloud API (Meta oficial) ---
WHATSAPP_TOKEN=
# Token que tu defines y registras en la config del webhook en Meta.
VERIFY_TOKEN=

# --- WhatsApp Business propio de GoAgenda (numero UNICO y compartido para
# notificar directamente a los CLIENTES finales de todos los negocios, ej.
# confirmacion de cita al agendar) - distinto de WHATSAPP_TOKEN de arriba,
# que es para el numero que cada negocio conecta por su cuenta. Ver
# services/whatsapp.py y el README (seccion WhatsApp). ---
GOAGENDA_WHATSAPP_TOKEN=
GOAGENDA_WHATSAPP_PHONE_NUMBER_ID=
GOAGENDA_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Message template (categoria UTILITY) aprobado en Meta para la
# confirmacion de cita al cliente - opcionales, el codigo ya trae estos
# mismos valores por defecto. Solo hace falta cambiarlos si se crea un
# template con otro nombre/idioma.
GOAGENDA_WHATSAPP_CONFIRMATION_TEMPLATE=confirmacion_cita_goagenda
GOAGENDA_WHATSAPP_CONFIRMATION_TEMPLATE_LANG=es_CO
# Message template (categoria UTILITY) aprobado en Meta para el recordatorio
# de cita, usado cuando el cliente nunca le ha escrito al numero propio del
# negocio (o ya paso mas de 24h desde su ultimo mensaje) - opcionales, el
# codigo ya trae estos mismos valores por defecto. El template todavia NO
# esta creado en Meta Business Manager, hay que crearlo/aprobarlo antes de
# que el envio funcione. Ver README (seccion WhatsApp).
WHATSAPP_REMINDER_TEMPLATE=recordatorio_cita_goagenda
WHATSAPP_REMINDER_TEMPLATE_LANG=es_CO

# --- Baileys (WhatsApp no oficial, microservicio aparte) ---
BAILEYS_SERVICE_URL=http://localhost:3000
# Debe ser EXACTAMENTE la misma key que usa el baileys-service (header x-api-key).
BAILEYS_INTERNAL_API_KEY=

# --- CORS (frontend) ---
# Lista separada por comas de origenes permitidos para el navegador.
# Ejemplo: http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Firebase (notificaciones push al dueño del negocio) ---
# Contenido completo del JSON de credenciales de servicio, pegado como texto
# en una sola linea. Alternativa para desarrollo local: dejar esto vacio y
# colocar el archivo firebase-credentials.json en la raiz del proyecto.
FIREBASE_CREDENTIALS_JSON=

# --- Super admin sembrado al arrancar (opcional, ver services/seed_super_admin.py) ---
# Si se completan ambas, el backend crea (o marca como super admin, si ya
# existe) este usuario en Supabase Auth cada vez que arranca. Dejar vacio
# para no sembrar ninguno.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
